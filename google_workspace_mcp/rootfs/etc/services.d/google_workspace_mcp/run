#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the Google Workspace MCP service
# ==============================================================================

set -e

declare -a cmd
declare -a tools
declare -a permissions

normalize_optional() {
    local value="$1"
    local lowered
    lowered="$(echo "${value}" | tr '[:upper:]' '[:lower:]')"

    case "${lowered}" in
        ""|"null"|"none")
            echo ""
            ;;
        *)
            echo "${value}"
            ;;
    esac
}

config() {
    normalize_optional "$(bashio::config "$1")"
}

auth_client_id="$(config 'google_oauth_client_id')"
auth_client_secret="$(config 'google_oauth_client_secret')"
external_url="$(config 'workspace_external_url')"

credentials_file="$(config 'authentication.google_client_secret_path')"
user_google_email="$(config 'authentication.user_google_email')"

credentials_dir="$(config 'credential_store.workspace_mcp_credentials_dir')"

base_uri="$(config 'server.workspace_mcp_base_uri')"
host="$(config 'server.workspace_mcp_host')"
port="$(config 'server.workspace_mcp_port')"
transport="$(config 'server.workspace_mcp_transport')"
session_idle_timeout="$(config 'server.workspace_mcp_session_idle_timeout')"

selected_tools="$(config 'tool_selection.workspace_mcp_tools')"
tool_tier="$(config 'tool_selection.workspace_mcp_tool_tier')"
permissions_raw="$(config 'tool_selection.workspace_mcp_permissions')"

oauth_storage_backend="$(config 'oauth21.workspace_mcp_oauth_proxy_storage_backend')"
oauth_proxy_disk_directory="$(config 'oauth21.workspace_mcp_oauth_proxy_disk_directory')"
jwt_signing_key="$(config 'oauth21.fastmcp_server_auth_google_jwt_signing_key')"
redirect_uri="$(config 'oauth21.google_oauth_redirect_uri')"
custom_redirect_uris="$(config 'oauth21.oauth_custom_redirect_uris')"
allowed_origins="$(config 'oauth21.oauth_allowed_origins')"
allowed_client_redirect_uris="$(config 'oauth21.workspace_mcp_allowed_client_redirect_uris')"

allowed_file_dirs="$(config 'local_files.allowed_file_dirs')"

[[ -z "${transport}" ]] && transport="streamable-http"
[[ -z "${host}" ]] && host="0.0.0.0"
[[ -z "${port}" ]] && port="8000"
[[ -z "${allowed_file_dirs}" ]] && allowed_file_dirs="/share"
[[ -z "${credentials_dir}" ]] && credentials_dir="/data/google_workspace_credentials"
[[ -z "${oauth_storage_backend}" ]] && oauth_storage_backend="disk"
[[ -z "${oauth_proxy_disk_directory}" ]] && oauth_proxy_disk_directory="${credentials_dir}/oauth-proxy"

if [[ "${oauth_storage_backend}" == "disk" ]]; then
    mkdir -p "${oauth_proxy_disk_directory}"
fi

mkdir -p "${credentials_dir}"
export GOOGLE_MCP_CREDENTIALS_DIR="${credentials_dir}"
export WORKSPACE_MCP_CREDENTIALS_DIR="${credentials_dir}"
export WORKSPACE_MCP_PORT="${port}"
export WORKSPACE_MCP_HOST="${host}"
export ALLOWED_FILE_DIRS="${allowed_file_dirs}"
export WORKSPACE_MCP_OAUTH_PROXY_STORAGE_BACKEND="${oauth_storage_backend}"
export WORKSPACE_MCP_OAUTH_PROXY_DISK_DIRECTORY="${oauth_proxy_disk_directory}"

[[ -n "${auth_client_id}" ]] && export GOOGLE_OAUTH_CLIENT_ID="${auth_client_id}"
[[ -n "${auth_client_secret}" ]] && export GOOGLE_OAUTH_CLIENT_SECRET="${auth_client_secret}"
[[ -n "${credentials_file}" ]] && export GOOGLE_CLIENT_SECRET_PATH="${credentials_file}"
[[ -n "${user_google_email}" ]] && export USER_GOOGLE_EMAIL="${user_google_email}"
[[ -n "${external_url}" ]] && export WORKSPACE_EXTERNAL_URL="${external_url}"
[[ -n "${base_uri}" ]] && export WORKSPACE_MCP_BASE_URI="${base_uri}"
[[ -n "${session_idle_timeout}" ]] && export WORKSPACE_MCP_SESSION_IDLE_TIMEOUT="${session_idle_timeout}"
[[ -n "${redirect_uri}" ]] && export GOOGLE_OAUTH_REDIRECT_URI="${redirect_uri}"
[[ -n "${custom_redirect_uris}" ]] && export OAUTH_CUSTOM_REDIRECT_URIS="${custom_redirect_uris}"
[[ -n "${allowed_origins}" ]] && export OAUTH_ALLOWED_ORIGINS="${allowed_origins}"
[[ -n "${jwt_signing_key}" ]] && export FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY="${jwt_signing_key}"
[[ -n "${allowed_client_redirect_uris}" ]] && export WORKSPACE_MCP_ALLOWED_CLIENT_REDIRECT_URIS="${allowed_client_redirect_uris}"

if bashio::config.true 'authentication.oauthlib_insecure_transport'; then
    export OAUTHLIB_INSECURE_TRANSPORT=1
fi
if bashio::config.true 'oauth21.mcp_enable_oauth21'; then
    export MCP_ENABLE_OAUTH21=true
fi
if bashio::config.true 'oauth21.external_oauth21_provider'; then
    export EXTERNAL_OAUTH21_PROVIDER=true
fi
if bashio::config.true 'oauth21.workspace_mcp_stateless_mode'; then
    export WORKSPACE_MCP_STATELESS_MODE=true
fi

cmd=(workspace-mcp --transport "${transport}")

if [[ -n "${tool_tier}" ]]; then
    cmd+=(--tool-tier "${tool_tier}")
fi

if [[ -n "${selected_tools}" ]]; then
    selected_tools="${selected_tools//,/ }"
    read -r -a tools <<< "${selected_tools}"
    if [[ ${#tools[@]} -gt 0 ]]; then
        cmd+=(--tools "${tools[@]}")
    fi
fi

if [[ -n "${permissions_raw}" ]]; then
    permissions_raw="${permissions_raw//,/ }"
    read -r -a permissions <<< "${permissions_raw}"
    if [[ ${#permissions[@]} -gt 0 ]]; then
        cmd+=(--permissions "${permissions[@]}")
    fi
fi

if bashio::config.true 'tool_selection.workspace_mcp_read_only'; then
    cmd+=(--read-only)
fi
if bashio::config.true 'authentication.single_user'; then
    cmd+=(--single-user)
fi

bashio::log.info "Starting Google Workspace MCP on ${host}:${port} with transport '${transport}'."

exec "${cmd[@]}"
