#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start the WhatsApp bridge (Go, whatsmeow).
#
# It keeps the linked-device session, writes messages to /data/store, and
# serves a REST API on 127.0.0.1:8080 that only the MCP server uses. On first
# start it prints a pairing QR code to this log. If it stays disconnected for
# more than 3 minutes it exits on purpose, and s6 restarts it.
# ==============================================================================

set -euo pipefail

# Patch 0003 logs message content, contact names and numbers at DEBUG only.
export BRIDGE_LOG_LEVEL="INFO"
if bashio::config.true 'advanced.debug_logging'; then
    bashio::log.level "debug"
    export BRIDGE_LOG_LEVEL="DEBUG"
fi

API_KEY="$(cat /data/bridge_api_key)"
export API_KEY
export API_BIND_HOST="127.0.0.1"
export API_PORT="8080"
# Current QR code for the pairing page (patch 0002); tmpfs-like, not /data.
export WA_QR_FILE="/tmp/whatsapp-qr/code"
# Optional manual override of the WhatsApp Web client version (see DOCS.md).
if bashio::config.has_value 'advanced.wa_client_version'; then
    WA_CLIENT_VERSION="$(bashio::config 'advanced.wa_client_version')"
    export WA_CLIENT_VERSION
fi

# The bridge resolves ./store relative to its working directory.
cd /data

bashio::log.info "Starting WhatsApp bridge..."
exec whatsapp-bridge
