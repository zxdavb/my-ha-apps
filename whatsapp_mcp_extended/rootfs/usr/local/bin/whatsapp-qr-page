#!/opt/venv/bin/python3
"""Pairing page for Home Assistant ingress ("Open Web UI").

The Home Assistant log viewer adds space between lines, which breaks the
half-block QR code the bridge prints. The bridge (patch 0002) also writes the
current QR code string to $WA_QR_FILE; this page renders it as an SVG and
refreshes itself. It shows the linked state from the bridge's local /api/health.

Only Home Assistant's ingress proxy may connect (it authenticates the user).
"""

import html
import json
import os
import time
import urllib.error
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

import segno

PORT = int(os.environ.get("QR_PAGE_PORT", "8099"))
QR_FILE = os.environ["WA_QR_FILE"]
BRIDGE = "http://127.0.0.1:8080/api"
INGRESS_PROXY = "172.30.32.2"
# whatsmeow's first code is valid for 60 s, later ones for 20 s.
MAX_CODE_AGE = 65


def bridge_status():
    # /api/health needs no API key. Authenticated endpoints would add an
    # [AUDIT] line to the app log on every page refresh. It answers 503
    # (with the same JSON) while not connected to WhatsApp.
    try:
        with urllib.request.urlopen(f"{BRIDGE}/health", timeout=5) as resp:
            status = json.load(resp)
    except urllib.error.HTTPError as err:
        try:
            status = json.load(err)
        except Exception:
            return {"error": str(err)}
    except Exception as err:  # bridge starting or restarting
        return {"error": str(err)}
    status["linked"] = not status.get("needs_pairing", True)
    return status


def current_code():
    try:
        if time.time() - os.path.getmtime(QR_FILE) > MAX_CODE_AGE:
            return None
        with open(QR_FILE, encoding="utf-8") as f:
            return f.read().strip() or None
    except OSError:
        return None


def render():
    status = bridge_status()
    if status.get("linked"):
        state = "connected" if status.get("connected") else "linked, reconnecting"
        body = f"<p class=ok>WhatsApp is linked ({html.escape(state)}). Nothing to scan.</p>"
    elif "error" in status:
        body = "<p>The WhatsApp bridge is starting. This page refreshes itself.</p>"
    else:
        code = current_code()
        if code:
            svg = segno.make_qr(code, error="l").svg_inline(scale=6, border=4, dark="#000", light="#fff")
            body = (
                "<p>On your phone: WhatsApp &gt; Settings &gt; Linked devices &gt; Link a device, then scan.</p>"
                f"<div class=qr>{svg}</div>"
                "<p class=hint>Codes change about every 20 seconds; this page follows them.</p>"
            )
        else:
            body = (
                "<p>No QR code right now. A new set is being requested; this page refreshes itself.</p>"
                "<p class=hint>Or use a pairing code: set <code>pairing.phone_number</code> and restart the app.</p>"
            )
    return f"""<!doctype html>
<html lang="en"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="refresh" content="5">
<title>WhatsApp pairing</title>
<style>
body {{ font-family: system-ui, sans-serif; margin: 16px; background: #fff; color: #111; }}
.qr {{ display: inline-block; padding: 8px; background: #fff; }}
.ok {{ color: #1b5e20; font-weight: 600; }}
.hint {{ color: #555; font-size: 0.9em; }}
</style></head>
<body><h2>WhatsApp pairing</h2>{body}</body></html>
"""


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.client_address[0] != INGRESS_PROXY:
            self.send_error(403)
            return
        page = render().encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Cache-Control", "no-store")
        self.send_header("Content-Length", str(len(page)))
        self.end_headers()
        self.wfile.write(page)

    def log_message(self, *args):
        pass  # keep the app log for the bridge


if __name__ == "__main__":
    print(f"Pairing page listening on port {PORT} (Home Assistant ingress only)", flush=True)
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
