+// writeQRFile stores the current QR code string at $WA_QR_FILE, if set, so
+// something else (e.g. a web page) can render it. No-op when unset.
+func writeQRFile(code string) {
+	path := os.Getenv("WA_QR_FILE")
+	if path == "" {
+		return
+	}
+	tmp := path + ".tmp"
+	if err := os.WriteFile(tmp, []byte(code), 0o600); err != nil {
+		fmt.Fprintf(os.Stderr, "failed to write QR file: %v\n", err)
+		return
+	}
+	if err := os.Rename(tmp, path); err != nil {
+		fmt.Fprintf(os.Stderr, "failed to write QR file: %v\n", err)
+	}
+}
+
+// removeQRFile deletes $WA_QR_FILE once its codes are no longer valid.
+func removeQRFile() {
+	if path := os.Getenv("WA_QR_FILE"); path != "" {
+		_ = os.Remove(path)
+	}
+}
